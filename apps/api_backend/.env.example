# API backend
# Public `replace_*` values are markers and are rejected at startup.
API_BIND_HOST=127.0.0.1
# API_TRUSTED_PROXIES=127.0.0.1
JWT_SECRET=replace_with_long_random_string
# Persistent application-data key. Generate independently from JWT_SECRET and back it up.
APP_ENCRYPTION_KEY=replace_with_independent_encryption_key
TOKEN_TTL=1h
MACHINE_TOKEN_TTL=30d
DATABASE_URL=postgresql://talos:talos@localhost:3004/talos
RMM_SERVER_API_KEY=replace_with_shared_rmm_server_key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional real, immutable, signed bootstrapper URL. Unset means no bootstrap is advertised.
# RMM_INSTALLER_BOOTSTRAP_URL=https://downloads.example.test/Talos.Agent.Setup.exe
# Update artifact public URLs are opt-in and must point to the operator's API.
# RMM_UPDATE_PUBLIC_BASE_URL=http://localhost:3001
# Absolute installer URLs prefer explicit operator values; configure these behind a reverse proxy.
# PUBLIC_API_URL=http://localhost:3001
# RMM_INSTALLER_PUBLIC_FRONTEND_URL=http://localhost:3000
# OPENAI_API_KEY=replace_with_openai_api_key
RMM_AI_ASSIST_ENABLED=false
OPENAI_COMPUTER_USE_MODEL=gpt-5.5
OPENAI_COMMAND_CENTER_MODEL=gpt-5.5
RMM_AI_ASSIST_MAX_STEPS=12
RMM_AI_ASSIST_MAX_ACTIONS_PER_STEP=8

# RMM telemetry: ingestion is done by the RMM telemetry producer (see apps/rmm_telemetry_producer).
# Set RMM_TELEMETRY_PRODUCER_URL in the RMM Server env (e.g. http://localhost:3003) to send snapshots/events to the producer.
RMM_TELEMETRY_SCOPE_BASELINE_MIN_DEVICES=2
RMM_TELEMETRY_SCOPE_BASELINE_MIN_SUPPORT_RATIO=0.7

# Service-to-service auth (shared with agent backend)
SERVICE_KEY=replace_with_shared_service_key
TALOS_AI_RUNNER_SERVICE_KEY=replace_with_shared_service_key
COMMAND_CENTER_AI_RUNNER_ARTIFACT_JSON_LIMIT=12mb
TALOS_AI_RUNNER_URL=http://localhost:3010
TALOS_AI_RUNNER_BIND_ADDR=127.0.0.1:3010
TALOS_AI_RUNNER_CALLBACK_BASE_URL=http://localhost:3001
TALOS_AI_RUNNER_JOB_TIMEOUT_SECS=420
TALOS_AI_RUNNER_SCREENSHOT_READ_TIMEOUT_SECS=60
TALOS_AI_RUNNER_APPROVAL_TIMEOUT_SECS=300
COMMAND_CENTER_AI_RUNNER_WAIT_TIMEOUT_MS=75000
RMM_SERVER_HTTP_URL=http://localhost:3002
