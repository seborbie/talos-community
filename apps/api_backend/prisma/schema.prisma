generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "rmm_telemetry", "command_center"]
}

// The rest of the schema is moved from apps/prisma/schema.prisma
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  memberships OrganizationMember[]
  rmmDeviceSavedViews RmmDeviceSavedView[]

  @@schema("public")
}

enum OrgRole {
  SUPER_ADMIN
  AGENT_ADMIN
  VIEWER

  @@schema("public")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Encrypted Halo PSA configuration for the organization
  haloBaseUrlEnc      String?
  haloClientIdEnc     String?
  haloClientSecretEnc String?

  members         OrganizationMember[]
  customers       Customer[]
  commandPolicies CommandPolicy[]
  installerProfiles RmmInstallerProfile[]
  installerTokens   RmmInstallerEnrollmentToken[]
  installerTokenUses RmmInstallerTokenUse[]
  installerDownloads RmmInstallerDownloadAudit[]
  rmmDeviceSavedViews RmmDeviceSavedView[]
  installerShortLinks RmmInstallerShortLink[]

  @@schema("public")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  role           OrgRole
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@schema("public")
}

model RmmDevice {
  agentId        String   @id @map("agent_id")
  organizationId String   @map("organization_id")
  hostname       String
  os             String
  ip             String
  version        String?
  lastSeen       DateTime @map("last_seen") @db.Timestamptz(3)
  websocketStatus         String   @default("unknown") @map("websocket_status")
  websocketConnectedAt    DateTime? @map("websocket_connected_at") @db.Timestamptz(3)
  websocketDisconnectedAt DateTime? @map("websocket_disconnected_at") @db.Timestamptz(3)
  customerId     String?  @map("customer_id")
  siteId         String?  @map("site_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  linuxShellUsername          String?   @map("linux_shell_username")
  linuxShellPasswordEnc       String?   @map("linux_shell_password_enc")
  linuxShellCredentialId      String?   @map("linux_shell_credential_id")
  linuxShellCredentialVersion Int?      @map("linux_shell_credential_version")
  linuxShellPasswordUpdatedAt DateTime? @map("linux_shell_password_updated_at") @db.Timestamptz(3)
  deviceType                  String    @default("unknown") @map("device_type")
  deviceTypeSource            String    @default("auto") @map("device_type_source")
  patchRing                   String    @default("broad") @map("patch_ring")
  criticalityTier             String?   @map("criticality_tier")
  patchManaged                Boolean   @default(true) @map("patch_managed")
  nativeWindowsUpdateControl  Boolean   @default(true) @map("native_windows_update_control")
  aiRunnerAutoApprove         Boolean   @default(false) @map("ai_runner_auto_approve")
  patchMaintenanceModeUntil   DateTime? @map("patch_maintenance_mode_until") @db.Timestamptz(3)
  patchTags                   Json      @default("[]") @map("patch_tags")
  nativeWindowsUpdateBackup   Json?     @map("native_windows_update_backup_jsonb")
  macosUpdateAccountStatus    String?   @map("macos_update_account_status")
  macosUpdateAccountRequired  Boolean?  @map("macos_update_account_required")
  macosUpdateAccountUsername  String?   @map("macos_update_account_username")
  macosUpdateAccountCredentialVersion Int? @map("macos_update_account_credential_version")
  macosUpdateAccountGeneratedUid String? @map("macos_update_account_generated_uid")
  macosUpdateAccountFailureCode String?  @map("macos_update_account_failure_code")
  macosUpdateAccountFailureMessage String? @map("macos_update_account_failure_message")
  macosUpdateAccountLastVerifiedAt DateTime? @map("macos_update_account_last_verified_at") @db.Timestamptz(3)
  macosUpdateAccountStatusJson Json?     @map("macos_update_account_status_jsonb")

  telemetryState             RmmTelemetryDeviceState?
  telemetrySnapshots         RmmTelemetrySnapshotIngest[]
  telemetrySnapshotRequests  RmmTelemetrySnapshotRequest[]
  telemetryInstalledApps     RmmTelemetryDeviceInstalledApp[]
  telemetryServices          RmmTelemetryDeviceService[]
  telemetryStartupItems      RmmTelemetryDeviceStartupItem[]
  telemetryWindowsFeatures   RmmTelemetryDeviceWindowsFeature[]
  telemetryPendingUpdates    RmmTelemetryDevicePendingUpdate[]
  telemetryInstalledUpdates  RmmTelemetryDeviceInstalledUpdate[]
  telemetryEvents            RmmTelemetryDeviceEvent[]
  telemetryFactState         RmmTelemetryFactStateCurrent[]
  telemetryFactChanges       RmmTelemetryFactChangeLog[]
  telemetryFactBaselines     RmmTelemetryFactBaseline[]
  telemetryScopedBaselines   RmmTelemetryFactBaselineScope[]
  telemetryDecisions         RmmTelemetryRoutingDecision[]
  telemetryRemediationJobs   RmmTelemetryRemediationJob[]
  telemetryProcessedMessages RmmTelemetryProcessedMessageLog[]
  patchUpdateStates          RmmPatchDeviceUpdateState[]
  healthAlerts               RmmAgentHealthAlert[]
  customer                   Customer?                           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site                       RmmSite?                            @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([organizationId, agentId])
  @@index([organizationId])
  @@index([lastSeen])
  @@index([customerId])
  @@index([siteId])
  @@index([websocketStatus])
  @@index([deviceType])
  @@index([patchRing])
  @@index([patchManaged])
  @@map("rmm_devices")
  @@schema("public")
}

model RmmAgentHealthAlert {
  id              BigInt    @id @default(autoincrement())
  organizationId  String    @map("organization_id")
  agentId         String    @map("agent_id")
  alertKey        String    @map("alert_key")
  severity        String
  status          String    @default("active")
  reason          String
  detail          String?
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  occurrenceCount Int       @default(1) @map("occurrence_count")
  context          Json      @default("{}") @map("context_jsonb")

  device RmmDevice @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@unique([organizationId, agentId, alertKey])
  @@index([organizationId, status, lastSeenAt])
  @@index([agentId, status, lastSeenAt])
  @@map("rmm_agent_health_alert")
  @@schema("public")
}

model RmmDeviceSavedView {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  name           String
  filters        Json     @default("{}")
  sortBy         String   @default("lastSeen") @map("sort_by")
  sortDirection  String   @default("desc") @map("sort_direction")
  pageSize       Int      @default(50) @map("page_size")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, name])
  @@index([organizationId, userId, updatedAt], map: "rmm_device_saved_views_organization_id_user_id_updated_at_idx")
  @@map("rmm_device_saved_views")
  @@schema("public")
}

model CommandCenterConversation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  title          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages CommandCenterMessage[]

  @@index([organizationId, userId, updatedAt], map: "command_center_conversations_org_user_updated_idx")
  @@map("conversations")
  @@schema("command_center")
}

model CommandCenterMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  model          String?
  responseId     String?  @map("response_id")
  metadata       Json?    @map("metadata_jsonb")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation CommandCenterConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "command_center_messages_conversation_id_fkey")

  @@index([conversationId, createdAt], map: "command_center_messages_conversation_created_idx")
  @@map("messages")
  @@schema("command_center")
}

model CommandCenterAiRunnerJob {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  conversationId String?  @map("conversation_id")
  agentId        String   @map("agent_id")
  goal           String?
  jobType        String   @default("desktop_goal") @map("job_type")
  status         String
  runnerId       String?  @map("runner_id")
  dispatchRequest Json?   @map("dispatch_request_jsonb")
  leaseId        String?  @map("lease_id")
  leaseOwnerRunnerId String? @map("lease_owner_runner_id")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz(3)
  cancelRequestedAt DateTime? @map("cancel_requested_at") @db.Timestamptz(3)
  resumeAttempt  Int      @default(0) @map("resume_attempt")
  retryable      Boolean  @default(false)
  retryReason    String?  @map("retry_reason")
  approvalId     String?  @map("approval_id")
  approvalChatSessionId String? @map("approval_chat_session_id")
  approvalRequestedAt DateTime? @map("approval_requested_at") @db.Timestamptz(3)
  approvalRespondedAt DateTime? @map("approval_responded_at") @db.Timestamptz(3)
  approvalExpiresAt DateTime? @map("approval_expires_at") @db.Timestamptz(3)
  approvalWindowExpiresAt DateTime? @map("approval_window_expires_at") @db.Timestamptz(3)
  resultMessageId String? @map("result_message_id")
  liveFrameMessageId String? @map("live_frame_message_id")
  result         Json?    @map("result_jsonb")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  artifacts CommandCenterAiRunnerArtifact[]
  commandApprovals CommandCenterAiRunnerCommandApproval[]
  events CommandCenterAiRunnerEvent[]

  @@index([organizationId, userId, updatedAt], map: "command_center_ai_runner_jobs_org_user_updated_idx")
  @@index([organizationId, agentId, updatedAt], map: "command_center_ai_runner_jobs_org_agent_updated_idx")
  @@index([conversationId], map: "command_center_ai_runner_jobs_conversation_idx")
  @@index([organizationId, userId, conversationId, status, updatedAt], map: "command_center_ai_runner_jobs_active_idx")
  @@index([approvalId], map: "command_center_ai_runner_jobs_approval_idx")
  @@index([leaseExpiresAt], map: "command_center_ai_runner_jobs_lease_expiry_idx")
  @@map("ai_runner_jobs")
  @@schema("command_center")
}

model CommandCenterAiRunnerArtifact {
  id             String   @id @default(cuid())
  jobId          String   @map("job_id")
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  artifactType   String   @map("artifact_type")
  name           String
  mimeType       String   @map("mime_type")
  contentBase64  String   @map("content_base64")
  metadata       Json?    @map("metadata_jsonb")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job CommandCenterAiRunnerJob @relation(fields: [jobId], references: [id], onDelete: Cascade, map: "command_center_ai_runner_artifacts_job_id_fkey")

  @@index([organizationId, userId, createdAt], map: "command_center_ai_runner_artifacts_org_user_created_idx")
  @@index([jobId, createdAt], map: "command_center_ai_runner_artifacts_job_created_idx")
  @@map("ai_runner_artifacts")
  @@schema("command_center")
}

model CommandCenterAiRunnerCommandApproval {
  id              String   @id @default(cuid())
  jobId           String   @map("job_id")
  organizationId  String   @map("organization_id")
  userId          String   @map("user_id")
  conversationId  String?  @map("conversation_id")
  agentId         String   @map("agent_id")
  turnIndex       Int      @map("turn_index")
  status          String
  command         String
  explanation     String
  risk            String
  notes           Json?    @map("notes_jsonb")
  message         String?
  modelResponseId String?  @map("model_response_id")
  policyAllowed   Boolean? @map("policy_allowed")
  policyReason    String?  @map("policy_reason")
  matchedPolicyId BigInt?  @map("matched_policy_id")
  decidedByUserId String?  @map("decided_by_user_id")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  output          String?
  outputLength    Int?     @map("output_length")
  exitCode        Int?     @map("exit_code")
  error           String?
  messageId       String?  @map("message_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  executedAt      DateTime? @map("executed_at") @db.Timestamptz(3)

  job CommandCenterAiRunnerJob @relation(fields: [jobId], references: [id], onDelete: Cascade, map: "command_center_ai_runner_command_approvals_job_id_fkey")
  events CommandCenterAiRunnerEvent[]

  @@unique([jobId, turnIndex], map: "command_center_ai_runner_command_approvals_job_turn_key")
  @@index([organizationId, userId, status, updatedAt], map: "command_center_ai_runner_command_approvals_org_user_status_idx")
  @@index([jobId, status, updatedAt], map: "command_center_ai_runner_command_approvals_job_status_idx")
  @@index([messageId], map: "command_center_ai_runner_command_approvals_message_idx")
  @@map("ai_runner_command_approvals")
  @@schema("command_center")
}

model CommandCenterAiRunnerEvent {
  id                String   @id @default(cuid())
  jobId             String   @map("job_id")
  organizationId    String   @map("organization_id")
  userId            String   @map("user_id")
  conversationId    String?  @map("conversation_id")
  agentId           String   @map("agent_id")
  eventKey          String   @map("event_key")
  eventType         String   @map("event_type")
  runnerId          String?  @map("runner_id")
  leaseId           String?  @map("lease_id")
  turnIndex         Int?     @map("turn_index")
  artifactFrameId   String?  @map("artifact_frame_id")
  commandApprovalId String?  @map("command_approval_id")
  artifactId        String?  @map("artifact_id")
  payload           Json?    @map("payload_jsonb")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job CommandCenterAiRunnerJob @relation(fields: [jobId], references: [id], onDelete: Cascade, map: "command_center_ai_runner_events_job_id_fkey")
  commandApproval CommandCenterAiRunnerCommandApproval? @relation(fields: [commandApprovalId], references: [id], onDelete: SetNull, map: "command_center_ai_runner_events_command_approval_id_fkey")

  @@unique([jobId, eventKey], map: "command_center_ai_runner_events_job_event_key")
  @@index([jobId, createdAt], map: "command_center_ai_runner_events_job_created_idx")
  @@index([organizationId, userId, createdAt], map: "command_center_ai_runner_events_org_user_created_idx")
  @@index([artifactId], map: "command_center_ai_runner_events_artifact_idx")
  @@index([commandApprovalId], map: "command_center_ai_runner_events_command_approval_idx")
  @@map("ai_runner_events")
  @@schema("command_center")
}

model CommandCenterAiRunnerApprovalGrant {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  agentId        String   @map("agent_id")
  jobType        String   @map("job_type")
  approvalId     String   @map("approval_id")
  jobId          String?  @map("job_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([organizationId, userId, agentId, jobType, expiresAt], map: "command_center_ai_runner_approval_grants_lookup_idx")
  @@index([approvalId], map: "command_center_ai_runner_approval_grants_approval_idx")
  @@map("ai_runner_approval_grants")
  @@schema("command_center")
}

model CommandCenterSecureNote {
  id              String    @id @default(cuid())
  code            String    @unique
  secretHandle    String    @unique @map("secret_handle")
  organizationId  String    @map("organization_id")
  createdByUserId String    @map("created_by_user_id")
  recipientUserId String    @map("recipient_user_id")
  recipientEmail  String?   @map("recipient_email")
  kind            String
  surface         String
  purpose         String?
  contentEnc      String?   @map("content_enc")
  contentLength   Int       @default(0) @map("content_length")
  shellReference  String?   @map("shell_reference")
  desktopReference String?  @map("desktop_reference")
  jobId           String?   @map("job_id")
  agentId         String?   @map("agent_id")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  viewedAt        DateTime? @map("viewed_at") @db.Timestamptz(3)
  destroyedAt     DateTime? @map("destroyed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, expiresAt], map: "command_center_secure_notes_org_expiry_idx")
  @@index([recipientUserId, expiresAt], map: "command_center_secure_notes_recipient_expiry_idx")
  @@index([jobId], map: "command_center_secure_notes_job_idx")
  @@index([expiresAt], map: "command_center_secure_notes_expiry_idx")
  @@map("secure_notes")
  @@schema("command_center")
}

model RmmEmergencyUpdateState {
  singletonKey String   @id @map("singleton_key")
  active       Boolean  @default(false)
  reason       String   @default("emergency")
  requestedBy  String?  @map("requested_by")
  triggeredAt  DateTime @default(now()) @map("triggered_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("rmm_emergency_update_state")
  @@schema("public")
}

model FeatureUpgradeIsoMedia {
  id            String   @id @default(cuid())
  displayName   String   @map("display_name")
  osFamily      String   @default("windows") @map("os_family")
  product       String
  version       String
  edition       String?
  architecture  String
  language      String?
  sha256        String?
  sizeBytes     BigInt?  @map("size_bytes")
  containerName String   @map("container_name")
  blobName      String   @map("blob_name")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  setupCommandMatrices FeatureUpgradeSetupCommandMatrix[]
  upgradeDevices        FeatureUpgradeDevice[]

  @@unique([containerName, blobName])
  @@index([active, osFamily])
  @@index([product, version])
  @@map("feature_upgrade_iso_media")
  @@schema("public")
}

model FeatureUpgradeSetupCommandMatrix {
  id                 String   @id @default(cuid())
  isoMediaId         String   @map("iso_media_id")
  osFamily           String   @default("windows") @map("os_family")
  product            String
  version            String
  edition            String?
  architecture       String
  language           String?
  setupExecutable    String   @default("{mount_drive}\\setup.exe") @map("setup_executable")
  arguments          Json     @default("[]") @map("arguments_jsonb")
  dynamicUpdateMode  String   @default("disable") @map("dynamic_update_mode")
  requiresEulaAccept Boolean  @default(false) @map("requires_eula_accept")
  imageIndexStrategy String   @default("auto_match_current_edition") @map("image_index_strategy")
  supported          Boolean  @default(true)
  notes              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  isoMedia FeatureUpgradeIsoMedia @relation(fields: [isoMediaId], references: [id], onDelete: Cascade)
  devices  FeatureUpgradeDevice[]

  @@unique([isoMediaId])
  @@index([active, supported])
  @@index([product, version])
  @@map("feature_upgrade_setup_command_matrix")
  @@schema("public")
}

model FeatureUpgradePreflightRun {
  id             String    @id
  organizationId String    @map("organization_id")
  requestedBy    String    @map("requested_by")
  status         String    @default("queued")
  totalDevices   Int       @default(0) @map("total_devices")
  queuedDevices  Int       @default(0) @map("queued_devices")
  runningDevices Int       @default(0) @map("running_devices")
  passedDevices  Int       @default(0) @map("passed_devices")
  warningDevices Int       @default(0) @map("warning_devices")
  failedDevices  Int       @default(0) @map("failed_devices")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  devices FeatureUpgradePreflightDevice[]

  @@index([organizationId, createdAt])
  @@map("feature_upgrade_preflight_run")
  @@schema("public")
}

model FeatureUpgradePreflightDevice {
  operationId     String    @id @map("operation_id")
  runId           String    @map("run_id")
  organizationId  String    @map("organization_id")
  agentId         String    @map("agent_id")
  sourceOs        String    @map("source_os")
  targetProduct   String    @map("target_product")
  targetVersion   String    @map("target_version")
  targetBuildLabel String   @map("target_build_label")
  status          String    @default("queued")
  phase           String    @default("queued")
  checkResults    Json      @default("[]") @map("check_results_jsonb")
  failureSummary  Json      @default("[]") @map("failure_summary_jsonb")
  warningSummary  Json      @default("[]") @map("warning_summary_jsonb")
  requestedBy     String    @map("requested_by")
  claimedAt       DateTime? @map("claimed_at") @db.Timestamptz(3)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  run FeatureUpgradePreflightRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId, updatedAt])
  @@index([agentId, status, createdAt])
  @@index([runId])
  @@map("feature_upgrade_preflight_device")
  @@schema("public")
}

model FeatureUpgradeIsoStageRun {
  id             String    @id
  organizationId String    @map("organization_id")
  requestedBy    String    @map("requested_by")
  status         String    @default("queued")
  totalDevices   Int       @default(0) @map("total_devices")
  queuedDevices  Int       @default(0) @map("queued_devices")
  runningDevices Int       @default(0) @map("running_devices")
  stagedDevices  Int       @default(0) @map("staged_devices")
  failedDevices  Int       @default(0) @map("failed_devices")
  deletedDevices Int       @default(0) @map("deleted_devices")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
