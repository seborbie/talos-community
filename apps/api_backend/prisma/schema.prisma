model RmmTelemetryAlertNotificationDelivery {
  id          BigInt   @id @default(autoincrement())
  alertId     BigInt   @map("alert_id")
  channel     String
  adapter     String
  status      String
  detail      String?
  externalRef String?  @map("external_ref")
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(3)

  @@index([alertId, attemptedAt])
  @@map("alert_notification_delivery")
  @@schema("rmm_telemetry")
}

model RmmTelemetryRoutingDecision {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id")
  agentId        String   @map("agent_id")
  domain         String
  triggerKey     String   @map("trigger_key")
  triggerValue   Json?    @map("trigger_value")
  action         String
  matchedRuleId  BigInt?  @map("matched_rule_id")
  intentId       String?  @map("intent_id")
  reason         String?
  dedupeKey      String?  @map("dedupe_key")
  source         String
  sourceTs       DateTime @map("source_ts") @db.Timestamptz(3)
  decidedAt      DateTime @default(now()) @map("decided_at")
  executionStatus String  @default("pending") @map("execution_status")
  externalRef    String?  @map("external_ref")
  outcomeMessage String?  @map("outcome_message")

  device          RmmDevice                    @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  matchedRule     RmmTelemetryRoutingRule?     @relation("RoutingRuleDecisions", fields: [matchedRuleId], references: [id], onDelete: SetNull)
  remediationJobs RmmTelemetryRemediationJob[]

  @@index([organizationId, sourceTs])
  @@index([agentId, sourceTs])
  @@map("routing_decision")
  @@schema("rmm_telemetry")
}

model RmmTelemetryRemediationJob {
  id             BigInt    @id @default(autoincrement())
  commandId      String?   @unique @map("command_id")
  organizationId String    @map("organization_id")
  agentId        String    @map("agent_id")
  decisionId     BigInt?   @map("decision_id")
  intentId       String    @map("intent_id")
  status         String    @default("queued")
  dedupeKey      String?   @unique @map("dedupe_key")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  requestedBy    String    @default("consumer") @map("requested_by")
  metadata       Json      @default("{}") @map("metadata_jsonb")

  device   RmmDevice                     @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  decision RmmTelemetryRoutingDecision?  @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  steps    RmmTelemetryRemediationStep[]

  @@index([organizationId, requestedAt])
  @@index([agentId, requestedAt])
  @@map("remediation_job")
  @@schema("rmm_telemetry")
}

model RmmTelemetryRemediationStep {
  id             BigInt    @id @default(autoincrement())
  organizationId String    @map("organization_id")
  jobId          BigInt    @map("job_id")
  stepIndex      Int       @map("step_index")
  command        String
  status         String    @default("pending")
  evidence       Json?     @map("evidence_jsonb")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  job RmmTelemetryRemediationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stepIndex])
  @@index([organizationId, startedAt])
  @@map("remediation_step")
  @@schema("rmm_telemetry")
}

model RmmTelemetryFactStabilityOverride {
  id              BigInt   @id @default(autoincrement())
  organizationId  String   @map("organization_id")
  factKeyPattern  String   @map("fact_key_pattern")
  stabilityClass  String   @map("stability_class")
  reason          String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, factKeyPattern])
  @@index([organizationId])
  @@map("fact_stability_override")
  @@schema("rmm_telemetry")
}

model RmmTelemetryIntent {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  name            String
  description     String?
  type            String   @default("hardcoded")
  allowList       Json?    @map("allow_list")
  steps           Json?
  aiPrompt        String?  @map("ai_prompt")
  triggerDomain   String?  @map("trigger_domain")
  triggerKey      String?  @map("trigger_key")
  requiresApproval Boolean @default(true) @map("requires_approval")
  maxRetries      Int      @default(1) @map("max_retries")
  timeoutSeconds  Int      @default(300) @map("timeout_seconds")
  enabled         Boolean  @default(true)
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([organizationId, enabled])
  @@index([organizationId, triggerDomain, triggerKey])
  @@map("intent")
  @@schema("rmm_telemetry")
}
