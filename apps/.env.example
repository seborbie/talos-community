# Public `replace_*` values are markers and are rejected at startup. Generate independent secrets
# for one installation; scripts/Setup-DevEnviroment.ps1 does this automatically on Windows.
# API backend
# Host-native API listeners default to loopback. Compose overrides this only inside its private
# network and publishes the host socket on loopback separately.
API_BIND_HOST=127.0.0.1
# Trust no forwarding proxy by default. If a reviewed reverse proxy is deployed, list its exact
# IP/CIDR (or an Express named range) rather than a hop count: API_TRUSTED_PROXIES=127.0.0.1
JWT_SECRET=replace_with_long_random_string
# Must be generated independently from JWT_SECRET. Changing it makes existing encrypted secrets
# unreadable, so back it up and rotate it through an explicit data-migration procedure.
APP_ENCRYPTION_KEY=replace_with_independent_encryption_key
TOKEN_TTL=1h
MACHINE_TOKEN_TTL=30d
DATABASE_URL=postgresql://talos:talos@localhost:3004/talos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RMM_SERVER_API_KEY=replace_with_shared_rmm_server_key
# Optional: scoped EXE SFX assembly inputs
# RMM_INSTALLER_SFX_STUB_PATH=apps/installer/artifacts/release/7zSD.sfx
# RMM_INSTALLER_PAYLOAD_7Z_PATH=apps/installer/artifacts/release/Talos.Agent.Setup.7z
# RMM_INSTALLER_PAYLOAD_EXE_NAME=Talos.Agent.Setup.exe
# Legacy/private-development escape hatch only. Request-time EXE assembly invalidates Authenticode
# signatures and is disabled by default. Public releases must use one immutable signed bootstrapper.
# RMM_ENABLE_UNSIGNED_SCOPED_INSTALLERS=false
# Optional URL of a real, immutable, signed bootstrapper. When unset the API returns null instead
# of advertising a nonexistent download.
# RMM_INSTALLER_BOOTSTRAP_URL=https://downloads.example.test/Talos.Agent.Setup.exe
# Optional override for URL stamped into installer (falls back to RMM_SERVER_URL)
# RMM_INSTALLER_SERVER_URL=ws://127.0.0.1:3002/agent/ws
RMM_TELEMETRY_KAFKA_BROKERS=required_comma_separated_brokers
RMM_TELEMETRY_SNAPSHOT_TOPIC=required_snapshot_topic_name
RMM_TELEMETRY_EVENTS_TOPIC=required_events_topic_name
RMM_TELEMETRY_SNAPSHOT_DLQ_TOPIC=rmm_telemetry_snapshots_dlq
RMM_TELEMETRY_CONSUMER_GROUP=rmm-telemetry-snapshot-consumer
RMM_TELEMETRY_MANIFEST_URL=http://localhost:3001/rmm/telemetry/manifest/snapshots
RMM_TELEMETRY_EVENTS_BATCH_URL=http://localhost:3001/rmm/telemetry/events/batch
RMM_TELEMETRY_GRAPH_APPLY_URL=http://localhost:3001/rmm/telemetry/graph/apply-batch
RMM_TELEMETRY_RULES_URL_BASE=http://localhost:3001/rmm/telemetry/rules
RMM_TELEMETRY_PROCESSED_CHECK_URL=http://localhost:3001/rmm/telemetry/messages/processed
RMM_TELEMETRY_SERVICE_KEY=replace_with_shared_service_key
RMM_TELEMETRY_MAX_RETRIES=5
RMM_TELEMETRY_RETRY_BASE_MS=500
RMM_TELEMETRY_BASELINE_STABILITY_THRESHOLD=3
RMM_TELEMETRY_OFFSET_COMMIT_RETENTION_MS=-1
RMM_TELEMETRY_SCOPE_BASELINE_MIN_DEVICES=2
RMM_TELEMETRY_SCOPE_BASELINE_MIN_SUPPORT_RATIO=0.7
RMM_AZURITE_CONTAINER=rmm-snapshots
RMM_AZURITE_BLOB_ENDPOINT=http://127.0.0.1:3008/devstoreaccount1
RMM_AZURITE_ACCOUNT_NAME=devstoreaccount1
RMM_AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# Feature upgrade ISO media library
# The API syncs *.iso blobs from this container into feature_upgrade_iso_media.
# Azure Storage Explorer must be connected to the same storage account as AZURE_STORAGE_CONNECTION_STRING.
# Set FEATURE_UPGRADE_ISO_PUBLIC_BLOB_ENDPOINT when the API uses a Docker-internal Azurite endpoint
# but workers need a host/public URL in generated SAS download links.
FEATURE_UPGRADE_ISO_CONTAINER=talos-feature-upgrade-isos
# Same-host development default. Remote workers need a reachable host name for this endpoint.
FEATURE_UPGRADE_ISO_PUBLIC_BLOB_ENDPOINT=http://localhost:3008/devstoreaccount1
FEATURE_UPGRADE_ISO_SAS_TTL_SECONDS=900
# Host-native API value. Compose deliberately substitutes its `azurite` service endpoint instead.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:3008/devstoreaccount1;

# Service-to-service auth
SERVICE_KEY=replace_with_shared_service_key
TALOS_AI_RUNNER_SERVICE_KEY=replace_with_shared_service_key
COMMAND_CENTER_AI_RUNNER_ARTIFACT_JSON_LIMIT=12mb

# API backend
API_BACKEND_URL=http://localhost:3001
# Optional. Uncomment both settings to enable OpenAI-backed features.
# OPENAI_API_KEY=replace_with_openai_api_key
RMM_AI_ASSIST_ENABLED=false
OPENAI_COMPUTER_USE_MODEL=gpt-5.4
OPENAI_COMMAND_CENTER_MODEL=gpt-5.5

# Frontend
INTERNAL_API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
PUBLIC_RMM_API_URL=http://localhost:3002
# Optional deployment-operator content. Leave empty to show a safe "not configured" notice.
# URLs must be absolute HTTP(S) URLs without embedded credentials.
PUBLIC_OPERATOR_NAME=
PUBLIC_SUPPORT_URL=
PUBLIC_TERMS_URL=
PUBLIC_PRIVACY_URL=
PUBLIC_SOURCE_URL=https://github.com/seborbie/talos-community

# Docker Compose host publication. Every port defaults to 127.0.0.1; uncomment only the individual
# service that must be reachable from another host, then configure firewall/TLS/CORS accordingly.
# TALOS_FRONTEND_HOST_BIND=0.0.0.0
# TALOS_API_HOST_BIND=0.0.0.0
# TALOS_RMM_SERVER_HOST_BIND=0.0.0.0
# RMM_RELAY_HOST_BIND=0.0.0.0
# TALOS_POSTGRES_HOST_BIND=0.0.0.0
# Full-stack-only overrides:
# TALOS_TELEMETRY_PRODUCER_HOST_BIND=0.0.0.0
# TALOS_REDPANDA_HOST_BIND=0.0.0.0
# TALOS_REDPANDA_ADVERTISED_HOST=host.example.net
# TALOS_REDPANDA_CONSOLE_HOST_BIND=0.0.0.0
# TALOS_AZURITE_HOST_BIND=0.0.0.0
# TALOS_AI_RUNNER_HOST_BIND=0.0.0.0

# RMM server (Rust)
RMM_BIND_ADDR=127.0.0.1:3002
API_BACKEND_URL=http://localhost:3001
# Host-native URL. Compose deliberately substitutes its service-DNS endpoint.
# When set, RMM Server sends telemetry (snapshots/events) to the producer instead of the API backend.
RMM_TELEMETRY_PRODUCER_URL=http://localhost:3003
RMM_AGENT_TOKEN=replace_with_shared_agent_token
RMM_MAX_OUTPUT_BYTES=51200
RMM_MAX_EXECUTION_SECS=60
# Same-host example. Remote agents need a reachable DNS name and matching trusted certificate.
RMM_RELAY_URL=localhost:17443

# AI runner (Rust); these localhost URLs are for host-native processes. Compose substitutes service DNS.
TALOS_AI_RUNNER_URL=http://localhost:3010
TALOS_AI_RUNNER_BIND_ADDR=127.0.0.1:3010
TALOS_AI_RUNNER_CALLBACK_BASE_URL=http://localhost:3001
TALOS_AI_RUNNER_JOB_TIMEOUT_SECS=420
TALOS_AI_RUNNER_SCREENSHOT_READ_TIMEOUT_SECS=60
TALOS_AI_RUNNER_APPROVAL_TIMEOUT_SECS=300
COMMAND_CENTER_AI_RUNNER_WAIT_TIMEOUT_MS=75000
RMM_SERVER_HTTP_URL=http://localhost:3002

# RMM agent (Rust)
RMM_SERVER_URL=ws://127.0.0.1:3002/agent/ws
# Optional direct-UDP discovery. It is intentionally disabled when unset; `auto` transport uses
# the relay fallback without contacting a third-party STUN service. Configure the same
# operator-controlled hostname-or-IPv4:port on worker and viewer hosts to opt in.
# RMM_STUN_SERVER=stun.example.net:3478

# RMM encode (agent - stream quality when viewing). Set in agent's .env (e.g. apps/.env).
# RMM_ENCODE_PRESET: grayscale, low, medium, high, maximum (default: medium)
# RMM_ENCODE_BITRATE: override bitrate in kbps (optional; preset bitrates: grayscale=200, low=500, medium=1500, high=4000, maximum=16000)
# RMM_ENCODE_CPUUSED: VP8 cpu_used 0-5 (0=slowest/best, 5=fastest; optional; default from vpx-encode)
# RMM_ENCODE_PRESET=medium
# RMM_ENCODE_BITRATE=2000
# RMM_ENCODE_CPUUSED=2

# RMM viewer (Tauri) - transport: auto (try QUIC then relay), quic (QUIC only), tcprelay (relay only, for testing)
RMM_VIEWER_TRANSPORT=auto
# RMM_DEBUG: 1/true/yes/on/debug — enables debug tracing and viewer debug console; rmm_agent + rmm_agent_helper use this only (not RUST_LOG).
# RMM_DEBUG=1
# RMM_DEBUG_OVERLAY: 1/true/yes to show debug overlay (bitrate, fps, preset, etc). Default: on.
# RMM_DEBUG_OVERLAY=1
# The worker and viewer use their operating-system trust stores. Install a private development CA
# there, or use a publicly trusted relay certificate. The optional AI runner runs in Docker and can
# load a mounted private CA explicitly:
# TALOS_AI_RUNNER_RELAY_CA_PATH=/.certs/local-dev-relay-ca.pem
# TALOS_AI_RUNNER_RELAY_CA_HOST_PATH=../apps/certs/local-dev-relay-ca.pem

# RMM relay (Rust)
RMM_RELAY_BIND_ADDR=127.0.0.1:443
# Compose mounts only these exact host files, never the containing directory. Relative host paths
# resolve from infra/. `bun run debug` maps them to native paths before starting the local relay.
# RMM_RELAY_TLS_CERT_HOST_PATH=../apps/certs/local-dev-relay-fullchain.pem
# RMM_RELAY_TLS_KEY_HOST_PATH=../apps/certs/local-dev-relay-key.pem
# These are the corresponding paths inside the relay container. For a direct `cargo run`, set
# native certificate/key paths in the invoking shell instead.
RMM_RELAY_TLS_CERT_PATH=/.certs/local-dev-relay-fullchain.pem
RMM_RELAY_TLS_KEY_PATH=/.certs/local-dev-relay-key.pem
RMM_RELAY_PENDING_TTL_SECS=600
RMM_RELAY_CLEANUP_INTERVAL_SECS=30
