{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talos Worker Chat",
  "version": "0.6.100",
  "identifier": "com.talos.worker-chat",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talos Chat",
        "width": 440,
        "height": 640,
        "resizable": true,
        "visible": true,
        "theme": "dark",
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "backgroundColor": "#07101c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
