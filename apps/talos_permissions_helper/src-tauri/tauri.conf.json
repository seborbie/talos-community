{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talos Permissions Helper",
  "version": "0.5.73",
  "identifier": "com.talos.permissions-helper",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talos Permissions Helper",
        "width": 640,
        "height": 660,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "theme": "dark",
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "backgroundColor": "#04091a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
