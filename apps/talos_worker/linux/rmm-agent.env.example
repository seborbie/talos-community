RMM_SERVER_URL=ws://127.0.0.1:3002/agent/ws
RMM_AGENT_TOKEN=replace-with-enrollment-token
RMM_AGENT_ID_PATH=/etc/talos/rmm_agent_id.txt
RMM_INVENTORY_INTERVAL_SECS=30
RMM_RECONNECT_MAX_SECS=30
RMM_COMMAND_TIMEOUT_SECS=120
RMM_SHELL_USER=talos
# Optional hostname-or-IPv4:port for direct-UDP discovery. Unset uses the relay fallback only.
# RMM_STUN_SERVER=stun.example.net:3478
# RMM_SHELL_ALLOW_ROOT=0
