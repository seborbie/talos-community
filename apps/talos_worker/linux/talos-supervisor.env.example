# Automatic updates are disabled until this points to your self-hosted API.
# RMM_UPDATE_BASE_URL=https://talos.example/rmm/updates
RMM_UPDATE_CHANNEL=stable
# RMM_UPDATE_RING=
RMM_WORKER_INSTALL_DIR=/opt/talos/worker
RMM_WORKER_ENV_FILE=/etc/talos/rmm-agent.env
RMM_WORKER_VERSION_PATH=/var/lib/talos/worker.version
RMM_WORKER_SERVICE_NAME=talos-worker
RMM_SUPERVISOR_SERVICE_NAME=talos-supervisor
RMM_SUPERVISOR_STARTUP_JITTER_SECS=0
RMM_SUPERVISOR_UPDATE_INTERVAL_SECS=86400
RMM_SUPERVISOR_MONITOR_INTERVAL_SECS=60
