# RMM Telemetry Producer
# Copy to .env and set values. RMM Server uses RMM_TELEMETRY_PRODUCER_URL to post here.

RMM_TELEMETRY_PRODUCER_BIND_ADDR=0.0.0.0:17120
RMM_SERVER_API_KEY=replace_with_shared_rmm_server_key

RMM_TELEMETRY_KAFKA_BROKERS=localhost:9092
RMM_TELEMETRY_SNAPSHOT_TOPIC=rmm_telemetry_snapshots
RMM_TELEMETRY_EVENTS_TOPIC=rmm_telemetry_events
